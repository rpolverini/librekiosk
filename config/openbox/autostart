# System-wide Openbox autostart (installed to /etc/xdg/openbox/autostart)
[ -r /etc/librekiosk/env ] && . /etc/librekiosk/env
[ "${LK_NO_BLANK:-1}" = 1 ] && xset s off s noblank -dpms
[ -r /usr/share/librekiosk/fondo.png ] && feh --bg-fill /usr/share/librekiosk/fondo.png &
tint2 &
nm-applet &
pasystray &
# PipeWire may not be up yet: retry for ~20 s, then give up.
( i=0; while [ $i -lt 20 ]; do
    wpctl set-volume @DEFAULT_AUDIO_SINK@ "${LK_VOLUME:-40}%" 2>/dev/null && wpctl set-mute @DEFAULT_AUDIO_SINK@ 0 && break
    i=$((i+1)); sleep 1
  done ) &
[ "${LK_KDECONNECT:-1}" = 1 ] && kdeconnect-indicator &
librekiosk-browser &
