#!/bin/sh
set -e
# trixie = Debian Stable at time of writing; bump when Debian releases a new stable.
lb config noauto \
	--distribution trixie \
	--architectures amd64 \
	--linux-flavours amd64 \
	--archive-areas "main contrib non-free-firmware" \
	--binary-images iso-hybrid \
	--debian-installer none \
	--memtest none \
	--iso-application LibreKiosk \
	--iso-volume LIBREKIOSK \
	--bootappend-live "boot=live components quiet username=libre hostname=librekiosk" \
	"${@}"
